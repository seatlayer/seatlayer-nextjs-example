# Your event key. It starts with ev_ and is at the top of the event's page in the dashboard (not the pk_ key).
NEXT_PUBLIC_SEATLAYER_EVENT_KEY=ev_replace_me

# Publishable key for the same account. It is safe in browser code.
# Never put a secret sk_ key in a front end bundle.
NEXT_PUBLIC_SEATLAYER_PUBLIC_KEY=pk_test_replace_me

# Optional. Two more event keys for the multiple events route. Each one falls
# back to NEXT_PUBLIC_SEATLAYER_EVENT_KEY when it is not set.
NEXT_PUBLIC_SEATLAYER_EVENT_KEY_2=
NEXT_PUBLIC_SEATLAYER_EVENT_KEY_3=

# Optional. A published season key for the season tickets route.
NEXT_PUBLIC_SEATLAYER_SEASON_KEY=

# Server only. Never prefixed with NEXT_PUBLIC_, so it stays out of the browser
# bundle. Enables the hold inspection and booking path in app/api/hold/route.ts
# and the real event catalogue in app/api/events/route.ts.
SEATLAYER_SECRET_KEY=
